#!/usr/bin/env bash
# Runs after orb activation and on every wake. Fast repair only: no installs,
# no network, and it never fails the thread — it reports a snapshot that no
# longer has its toolchain or dependencies so the agent knows to rerun setup.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

missing=""
for tool in node pnpm bun; do
  command -v "$tool" >/dev/null 2>&1 || missing="$missing $tool"
done

if [ -n "$missing" ]; then
  echo "resume: missing toolchain:$missing — run .agents/setup" >&2
elif [ ! -d node_modules ]; then
  echo "resume: node_modules is gone — run .agents/setup" >&2
fi
