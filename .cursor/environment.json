{
  "name": "Lutra",
  "install": "./.cursor/install.sh",
  "terminals": [
    {
      "name": "dev",
      "command": "cd packages/frontend && exec ./node_modules/.bin/vite --host 0.0.0.0 --port 5173 --strictPort",
